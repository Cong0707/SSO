SSO_ADDR=:8080
SSO_ISSUER=http://127.0.0.1:8080
SSO_DATABASE_DRIVER=postgres
SSO_DATABASE_DSN=host=127.0.0.1 user=sso password=change-me dbname=sso port=5432 sslmode=disable TimeZone=UTC
SSO_DATA_DIR=data
SSO_MASTER_KEY_FILE=data/master.key
SSO_OIDC_SIGNING_KEY_FILE=data/oidc-signing.pem
SSO_ALLOW_KEY_GENERATION=true
SSO_WEB_DIR=web/dist
SSO_COOKIE_SECURE=false
SSO_SESSION_TTL=720h
SSO_REGISTRATION_ENABLED=true
SSO_TRUSTED_PROXIES=

# docker compose development database values
POSTGRES_DB=sso
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso-dev-password

# Optional upstream identity providers. Empty values leave the provider disabled.
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
SSO_DISCORD_CLIENT_ID=
SSO_DISCORD_CLIENT_SECRET=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_ISSUER=
SSO_LINUXDO_CLIENT_ID=
SSO_LINUXDO_CLIENT_SECRET=
SSO_TELEGRAM_BOT_TOKEN=
SSO_WECHAT_CLIENT_ID=
SSO_WECHAT_CLIENT_SECRET=
