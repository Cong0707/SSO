SSO_ADDR=:8080
SSO_ISSUER=http://127.0.0.1:8080
SSO_DATABASE_DRIVER=postgres
SSO_DATABASE_DSN=host=127.0.0.1 user=sso password=change-me dbname=sso port=5432 sslmode=disable TimeZone=UTC
SSO_DATA_DIR=data
SSO_MASTER_KEY_FILE=data/master.key
SSO_OIDC_SIGNING_KEY_FILE=data/oidc-signing.pem
SSO_ALLOW_KEY_GENERATION=true
SSO_WEB_DIR=web/dist
SSO_COOKIE_SECURE=false
SSO_SESSION_TTL=720h
SSO_REGISTRATION_ENABLED=true
SSO_EMAIL_DEBUG=false
SSO_TRUSTED_PROXIES=

# Shared rate limiting. PostgreSQL deployments require Redis by default.
SSO_RATE_LIMIT_ENABLED=true
SSO_REDIS_ADDR=127.0.0.1:6379
SSO_REDIS_PASSWORD=
SSO_REDIS_DB=0
SSO_REDIS_TLS=false
SSO_REDIS_TLS_SERVER_NAME=
SSO_REDIS_KEY_PREFIX=xem-sso
SSO_RATE_LIMIT_IDENTIFY=30
SSO_RATE_LIMIT_LOGIN=10
SSO_RATE_LIMIT_EMAIL=5
SSO_RATE_LIMIT_OAUTH_TOKEN=120
SSO_RATE_LIMIT_SENSITIVE=60

# Bootstrap mail configuration. After the first verified account becomes admin,
# these values can be managed from 管理 -> 系统设置.
SSO_SMTP_HOST=
SSO_SMTP_PORT=587
SSO_SMTP_USERNAME=
SSO_SMTP_PASSWORD=
SSO_SMTP_FROM=

# Bot protection: none / turnstile / cap
SSO_CAPTCHA_MODE=none
SSO_TURNSTILE_SITE_KEY=
SSO_TURNSTILE_SECRET_KEY=
SSO_CAP_SITE_KEY=
SSO_CAP_SECRET_KEY=
SSO_CAP_SERVER_URL=http://cap:3000

# docker compose development database values
POSTGRES_DB=sso
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso-dev-password
REDIS_PASSWORD=sso-dev-redis-password

# Optional upstream identity providers. Empty values leave the provider disabled.
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
SSO_DISCORD_CLIENT_ID=
SSO_DISCORD_CLIENT_SECRET=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_ISSUER=
SSO_LINUXDO_CLIENT_ID=
SSO_LINUXDO_CLIENT_SECRET=
SSO_TELEGRAM_BOT_TOKEN=
SSO_TELEGRAM_BOT_USERNAME=
SSO_WECHAT_CLIENT_ID=
SSO_WECHAT_CLIENT_SECRET=
